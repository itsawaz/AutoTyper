# ── Turso / libSQL ─────────────────────────────────────────────
# Create a DB at https://turso.tech then run: turso db show <name> --url
# and: turso db tokens create <name>
TURSO_DATABASE_URL=libsql://your-db-name-yourorg.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Auth ───────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=43200

# ── Payments ───────────────────────────────────────────────────
# upi_gmail = free UPI collection confirmed by reading bank credit-alert emails.
# mock      = no real money, for local testing of the whole buy flow.
PAYMENT_PROVIDER=upi_gmail

# Your receiving UPI ID (VPA) and the payee name shown in the UPI app.
UPI_VPA=your-vpa@bank
UPI_PAYEE_NAME=AutoTyper

# Which bank's credit-alert email format to parse: hdfc | paytm | generic
UPI_BANK_PARSER=hdfc
# Only trust alerts from this sender address (anti-spoofing). Blank to disable.
UPI_ALERT_SENDER=alerts@hdfcbank.bank.in

# Unique-amount tagging: each order = base price + a random paise tag in this
# range so an incoming alert maps to exactly one order.
UPI_TAG_MIN_PAISE=1
UPI_TAG_MAX_PAISE=99
# Pending orders older than this (minutes) expire and won't be matched.
UPI_ORDER_TTL_MINUTES=30

# ── Gmail API (read-only) ──────────────────────────────────────
# Create a Google Cloud project, enable the Gmail API, make an OAuth client
# (Desktop), then run get_gmail_token.py to mint a refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Only read emails under this Gmail label (set a filter to apply it to alerts).
GMAIL_LABEL=upi-alerts

# Secret the Gmail poll endpoint requires (Vercel cron / manual triggers).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POLL_SECRET=change-me

# ── Pricing ────────────────────────────────────────────────────
# Price the user pays per 1 hour of usage, in paise. 4900 = ₹49.00.
PRICE_PER_HOUR_PAISE=4900
CURRENCY=INR
