# ── Turso / libSQL ─────────────────────────────────────────────
# Create a DB at https://turso.tech then run: turso db show <name> --url
# and: turso db tokens create <name>
TURSO_DATABASE_URL=libsql://your-db-name-yourorg.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Auth ───────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=43200

# ── Payments (Juspay) ──────────────────────────────────────────
# PAYMENT_PROVIDER: "mock" (default, no real money, for testing the full flow)
#                   or "juspay" (uses the keys below).
PAYMENT_PROVIDER=mock

# Juspay credentials (only needed when PAYMENT_PROVIDER=juspay).
# These are SERVER-side secrets and must never ship inside the desktop app.
JUSPAY_API_KEY=your-juspay-api-key
JUSPAY_MERCHANT_ID=your-juspay-merchant-id
JUSPAY_BASE_URL=https://sandbox.juspay.in
# Secret used to verify Juspay webhook callbacks (HTTP basic / signature).
JUSPAY_WEBHOOK_USERNAME=your-webhook-username
JUSPAY_WEBHOOK_PASSWORD=your-webhook-password

# Where Juspay redirects the user's browser after payment.
PAYMENT_RETURN_URL=https://example.com/payment-return

# ── Pricing ────────────────────────────────────────────────────
# Price the user pays per 1 hour of usage, in paise (smallest INR unit).
# 4900 paise = ₹49.00 per hour.
PRICE_PER_HOUR_PAISE=4900
CURRENCY=INR
